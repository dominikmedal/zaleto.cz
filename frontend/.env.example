# Zkopíruj do .env.local a doplň hodnoty. Nikdy necommituj skutečné klíče.
DATABASE_URL=            # Neon pooled connection string
DATABASE_URL_UNPOOLED=   # Neon direct (pro scraper a dump)
ADMIN_PASSWORD=
REVALIDATE_SECRET=
BLOB_READ_WRITE_TOKEN=   # Vercel Blob (nahrávání obrázků v administraci)
UNSPLASH_ACCESS_KEY=     # výběr fotek destinací v administraci (/admin/fotky)
PEXELS_API_KEY=          # volitelné
GOOGLE_PLACES_API_KEY=   # volitelné (recenze hotelů)
RESEND_API_KEY=
REPORT_TO=
REPORT_FROM=
